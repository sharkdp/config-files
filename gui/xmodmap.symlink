# keycode 26 = e E EuroSign EuroSign
keycode 27 = r R backslash backslash backslash backslash
# keycode 34 = bracketleft braceleft udiaeresis Udiaeresis
keycode 46 = l L percent percent percent percent
# keycode 47 = semicolon colon odiaeresis Odiaeresis
# keycode 48 = apostrophe quotedbl adiaeresis Adiaeresis
keycode 52 = z Z braceleft braceleft braceleft braceleft
keycode 53 = x X braceright braceright braceright braceright
keycode 54 = c C braceleft braceleft braceleft braceleft
keycode 55 = v V braceright braceright braceright braceright
keycode 42 = g G dollar dollar dollar dollar
